{
  "name": "server",
  "version": "1.0.0",
  "description": "this is a server package for writers-discuss",
  "keywords": [
    "writers-discuss",
    "author",
    "about-writers",
    "writing-ideas",
    "progressing-plots"
  ],
  "license": "ISC",
  "author": "harshal warade",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn -r tsconfig-paths/register src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "_moduleAliases": {
    "@config": "dist/config",
    "@controllers": "dist/controllers",
    "@models": "dist/models",
    "@routes": "dist/routes"
  }
}